# =============================================================================
# NitroStack & Application Environment Configuration
# =============================================================================
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode (stdio | sse).
# Defaults to 'stdio' for desktop AI clients and 'sse' for web AI models.
MCP_TRANSPORT_TYPE=stdio
PORT=8000
HOST=127.0.0.1
ENABLE_CORS=true

# Security & Authentication Configuration
# =============================================================================
# JWT_SECRET: Secret key for signing HS256 JWT tokens and OAuth sessions
JWT_SECRET=generate_a_secure_random_hex_key_here

# AI Model Provider API Keys (Optional - Built-in Expert Agent works with 0 keys)
# =============================================================================
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# SUMO Simulator & Python Configuration
# =============================================================================
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
PYTHON_PATH=python
SUMO_WORKSPACE_DIR=.

# Execution Mode Settings
# =============================================================================
# HEADLESS_MODE: Set 'true' for headless cloud containers, 'false' for local GUI playback
HEADLESS_MODE=false
NITRO_CLOUD=false



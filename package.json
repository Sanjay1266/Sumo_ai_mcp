{
  "name": "sumo-ai-web-application",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SUMO AI Web Application – Microscopic Urban Traffic Simulation & Multi-AI Analytics Platform",
  "scripts": {
    "start": "python web_app.py",
    "start:web": "python web_app.py --open-browser",
    "start:browser": "python main.py --mode web --open-browser",
    "start:app": "python sumo_server.py --web --open-browser",
    "start:unified": "python main.py --mode all",
    "dev": "python web_app.py --open-browser",
    "test": "python test_web_app.py",
    "test:ai": "python test_ai_integration.py",
    "test:audit": "python test_audit.py",
    "test:all": "python test_ai_integration.py && python test_web_app.py && python test_audit.py",
    "start:stdio": "python main.py --mode stdio",
    "start:auth": "python auth_server.py",
    "start:mcp": "python sumo_server.py --transport sse",
    "launch:local": "node scripts/launch_local_gui.js",
    "build": "nitrostack-cli build",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "@nitrostack/core": "^1.0.14",
    "zod": "^3.22.4",
    "@modelcontextprotocol/ext-apps": ">=0.1.0"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "author": "Sanjay S",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
